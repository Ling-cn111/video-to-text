{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "视频转文字",
  "version": "0.1.8",
  "identifier": "com.videototext.desktop",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "node scripts/build-desktop.mjs"
  },
  "app": {
    "windows": [
      {
        "title": "视频转文字",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": {
          "zh-CN": {
            "localePath": "wix/zh-CN.wxl"
          }
        }
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Ling-cn111/video-to-text/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERBRkM3Q0Y4RkQxNTA3QTkKUldTcEJ4WDkrSHo4MmxWQXhjaFdiV0dxWHA4TDhWeTliQ1FSYm9kZ1oyTFVJVERjOGZ0eWlmVnAK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
