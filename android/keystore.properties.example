# Release 签名配置模板 —— 复制为 keystore.properties 并填入真实值。
#
# ⚠️ 这个文件（keystore.properties）与 keystore 本身**绝不能入库**：
# .gitignore 已忽略 android/keystore.properties 与 *.jks / *.keystore。
#
# ⚠️ keystore 丢失 = 已安装用户永远无法升级（Android 用签名证书判定「是不是同一个应用」）。
# 生成后请立刻备份到至少两个地方（密码管理器 / 离线介质）。
#
# 生成 keystore：
#   keytool -genkeypair -v -keystore vtt-release.jks -alias vtt \
#     -keyalg RSA -keysize 2048 -validity 10950 \
#     -dname "CN=video-to-text, OU=Mobile, O=video-to-text, L=Hangzhou, ST=Zhejiang, C=CN"
#
# storeFile 支持绝对路径或相对 android/ 的路径。

storeFile=/absolute/path/to/vtt-release.jks
storePassword=填你的密码
keyAlias=vtt
keyPassword=填你的密码
