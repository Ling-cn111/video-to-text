<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
                从别的 App「分享」文本过来（B站 App 的分享按钮走的就是这条）。

                为什么只声明 ACTION_SEND，不声明 https 域名的 ACTION_VIEW：
                声明 `https://*.bilibili.com` 会让本应用成为**所有** B站 链接的
                候选打开方式。我们没有那些域名的所有权，无法通过 Android App Links
                的 autoVerify 校验，于是用户每点一次 B站 链接都会弹一次
                「用哪个应用打开」——把一次便利变成长期的打扰。
                分享意图没有这个问题：它只出现在用户主动点「分享」之后。

                mimeType 必须是 text/plain：B站 分享的是纯文本（标题 + 短链），
                不是文件流，也不是 text/html。
            -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!--
        应用内更新必需的权限（Android 8.0 / API 26 起）。

        它不是「允许自己偷偷安装」：只是让本应用有资格出现在系统的「安装未知
        应用」白名单里，用户仍要逐个应用授权，安装时系统安装器还会再弹一次确认。
        没有这一条 `canRequestPackageInstalls()` 恒为 false，带 apk 的
        `ACTION_VIEW` intent 会被系统直接拒绝。
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
</manifest>
