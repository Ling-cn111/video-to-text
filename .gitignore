# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# 桌面端构建：Mock 路由的临时暂存目录（scripts/build-desktop.mjs 用后即删）
/.desktop-build/

# 安装包产物（由 pnpm tauri build 生成，不入库；分发走 GitHub Release）
/dist/

# Tauri / Rust 编译产物（src-tauri/.gitignore 已含 /target、/gen/schemas）

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local tooling / assistant workspace state
.mimosa/
.zcode/

# backend (python)
backend/.venv/
__pycache__/
.pytest_cache/

# env 备份文件不入库
.env.local.bak

# backend 转写音频工作目录
backend/.audio/
backend/.audio-body.json
backend/.audio-debug*/
backend/.audio-bench/

# playwright
/test-results/
/playwright-report/

# 任务持久化数据库（任务 H）
backend/data/

# 任务 J：启动脚本运行产物
logs/
.vtt-pids/

# 部署脚本：deploy.ps1 里要填真实密钥（Redis 密码 / ASR Key / Worker Token），
# 绝不能入库
deploy.ps1

# Vercel CLI 会往 .env.local 追加 OIDC token：.env*.local 已在上面忽略，
# 这里补上 CLI 可能生成的环境文件。注意不要写成 `.env*` —— 那会把入库的
# .env.example 也一起忽略，后续新增配置模板时容易漏提交。
.vercel
.env.vercel
