# 后端环境变量示例（FastAPI，位于 backend/）

# CORS 白名单（逗号分隔，覆盖默认值 http://localhost:3000,http://127.0.0.1:3000）
# 生产环境建议把自己的正式域名也加进来
CORS_ORIGINS=http://localhost:3000

# 额外的正则白名单（默认放行所有 *.vercel.app 预览/生产域）
CORS_ORIGIN_REGEX=https://.*\.vercel\.app

# yt-dlp 提取信息超时（秒）
EXTRACT_TIMEOUT_SECONDS=30

# 任务持久化（SQLite）路径；默认 backend/data/tasks.db（目录自动创建，已入 .gitignore）
# TASK_DB_PATH=

# 任务存储后端：memory（默认，SQLite 落盘 + 内存一级缓存）| redis（多实例/云端部署）
# TASK_STORE=memory

# 任务保留期（秒，S2-P0）：create/update 写入时附带 EX 并滑动续期；0 = 不设 TTL（永久保留）
# 默认 604800 = 7 天。任务 JSON 含完整文字稿，无 TTL 会让 Redis 无限增长
# TASK_TTL_SECONDS=604800

# 任务分发模式（S2-P1/P3）：inline（默认，BackgroundTasks 同进程执行）| fc | mns | redis
# inline = 本地开发/单机部署；fc = 投递到 FC worker 函数的 HTTP 触发器（异步，需配 WORKER_URL）；
# mns / redis 为 P4 的实现位，当前显式报错（不会静默丢任务）；配错模式会告警并降级 inline
# ENQUEUE_MODE=inline

# ---- FC 异步分发（S2-P3，仅 ENQUEUE_MODE=fc 时需要）----

# worker 函数的 HTTP 触发器地址（`s info -t s.yaml` 里的 worker URL），形如：
#   https://video-to-text-worker.<随机串>.cn-hangzhou.fcapp.run
# 必须显式配置：fcapp.run 的子域含随机串，无法由 region + 函数名推导。
# 漏配不会阻断启动，但每次分发都会失败（任务标 failed + 500）
# WORKER_URL=

# worker 函数上的作业路由，须与 app/worker_app.py 的 WORKER_PATH 一致
# WORKER_PATH=/internal/worker/transcribe

# 异步投递超时（秒）：只等 FC 回 202，不等作业跑完，5 秒足够
# ASYNC_TIMEOUT_SECONDS=5

# 启动恢复模式（S2-P0）：recover（默认，API 侧把「陈旧」processing 任务标记 interrupted）| none
# Worker / 只读实例必须设 none：Serverless 每次冷启动都会执行启动初始化，
# recover 会把其他实例正在跑的任务误判为「已中断」
# TASK_INIT_MODE=recover

# 「陈旧」判定阈值（秒）与进度心跳间隔（秒，S2-P0）
# 超过 TASK_STALE_SECONDS 没有心跳写入的 processing 任务，才在启动恢复时判为 interrupted；
# 必须明显大于 TASK_HEARTBEAT_SECONDS（下载/FFmpeg/ASR 等长阻塞步骤靠心跳保活）
# TASK_STALE_SECONDS=600
# TASK_HEARTBEAT_SECONDS=30

# 任务执行锁（秒，S2-P2）：Worker 领取任务时 SET NX EX 的 TTL，执行期间按心跳续期。
# 崩溃后锁到期自动释放，平台重试才能重新领取；必须远大于心跳间隔
# TASK_LOCK_SECONDS=3600

# Worker 端点鉴权（S2-P2，P0 后为**必填**）：为空时 Worker 所有入口一律 503
# （fail-closed）。线上漏配一个环境变量就等于把异步执行入口敞开给公网——任何人都能
# POST 任意 url 让 Worker 去抓（SSRF）并刷 ASR 额度。
# 非空时要求下列任一匹配：X-Worker-Token / Authorization: Bearer <token> /
# 定时触发器 payload 里的 token（FC 定时触发器带不了自定义请求头，见 s.yaml 的 reapTimer）
# 本地开发：随便填一个非空值即可，例如 test-worker-token
# WORKER_TOKEN=

# ---- 僵尸任务清理（S2-P4 Reaper）----
# 线上由 FC 定时触发器（s.yaml 的 reapTimer，每 5 分钟）驱动，无需本地配置。
# 本地想手工验一遍：cd backend && python -m scripts.reap --dry-run
# Reaper 互斥锁 TTL（秒）：只需覆盖单次扫描耗时；多个实例同时扫时只有一个真正干活
# REAPER_LOCK_SECONDS=120
# 排队中任务的判定阈值（秒，P1）：started_at 为空说明 Worker 还没领到它，没有心跳，
# 用 TASK_STALE_SECONDS（600）会把还在排队的任务误判成超时。实际生效取
# max(TASK_STALE_SECONDS, 本项)
# REAPER_QUEUED_STALE_SECONDS=1800

# ---- 部署机变量（S2-Deploy）----
# 以下 4 项只被 `s deploy -t s.yaml` 读取（${env('NAME')}），应用运行时不读、也不会
# 出现在容器的环境变量里。放在这里只是集中备忘。
#
# VPC / 交换机 / 安全组：云 Redis 的内网地址只在 VPC 内可达，三个 ID 缺一不可
# （故意不给默认值：缺了部署时直接报错，优于「部署成功但运行期连不上 Redis」）。
# 交换机必须落在 FC 支持的可用区（cn-hangzhou: h/i/j/k/f/g），否则报
# InvalidArgument: vSwitch is in unsupported zone。
# FC_VPC_ID=vpc-bp1xxxxxxxxxxxx
# FC_VSWITCH_ID=vsw-bp1xxxxxxxxxxxx
# FC_SECURITY_GROUP_ID=sg-bp1xxxxxxxxxxxx
#
# 函数执行角色（可选）：留空 = 使用 FC 服务关联角色 AliyunServiceRoleForFC，
# 它已覆盖「写 SLS 日志 + 创建 ENI 打通 VPC + 拉取同账号 ACR 镜像」。
# 只有「函数代码里访问其他云服务」才需要填自定义角色 ARN。
# 详见 docs/serverless-deploy.md §4.3
# FC_ROLE_ARN=acs:ram::<账号ID>:role/<角色名>

# Redis 连接串：TASK_STORE=redis 时必填；S1-C 起也用于「限流共享计数」（多实例部署总配额一致）
# 需要可选依赖 pip install -r requirements-redis.txt；
# 未配置或运行期故障时自动降级（存储回 memory / 限流回进程内令牌桶）并打警告
# REDIS_URL=redis://localhost:6379/0

# 请求限流：每个客户端每分钟 POST 请求数上限（令牌桶，仅拦 POST）；0 = 禁用
# 配置 REDIS_URL 后改用 Redis 共享计数（多实例总配额一致）；否则/故障时降级进程内令牌桶
RATE_LIMIT_PER_MINUTE=10

# 全站兜底配额：所有客户端合计每分钟 POST 上限；0 = 禁用。
# 为什么需要：本 API 无鉴权，限流是唯一防线。客户端标识（IP）在 Serverless 网关后
# 可能被伪造，也可能全体塌缩成同一个值——只有总量硬上限能在标识不可信时给钱包兜底。
# 默认 120 远高于正常使用（一次转写约 3 次 POST），只挡机器刷量。
# RATE_LIMIT_GLOBAL_PER_MINUTE=120

# 可信反向代理网段（CIDR，逗号分隔）。留空 = 完全忽略 X-Forwarded-For（默认，最安全）。
# 只有 TCP 对端命中这里时才会解析该头，并从右往左取第一个不可信地址——
# 伪造者塞在最左边的值因此永远无效。前提是代理确实会追加/覆写该头。
# 例：阿里云 FC 内部代理 → 100.64.0.0/10,127.0.0.1
# TRUSTED_PROXY_CIDRS=

# HuggingFace 端点（模型下载/校验走镜像；后端已默认注入，无需配置。
# 若你在其他终端手动设置过 HF_ENDPOINT，以其为准）
# HF_ENDPOINT=https://hf-mirror.com

# ---- 转写（ASR）----

# 音频大小上限（MB，S1-B 内存化）：下载时按 content-length 预检 + 边拉边累计，
# 超限抛 AUDIO_TOO_LARGE（「音频过大，暂不支持」），避免整块载入内存 OOM
# MAX_AUDIO_SIZE_MB=100

# ASR 引擎：local（faster-whisper 本地推理，默认）| cloud（OpenAI 兼容接口）
# 场景推荐：
#   追求速度     → local + WHISPER_MODEL=base
#   平衡（推荐） → local + WHISPER_MODEL=small
#   追求准确     → local + WHISPER_MODEL=medium 或 large-v3（large-v3 建议 GPU）
#   高精度云端   → ASR_ENGINE=cloud（见下方云端配置）
ASR_ENGINE=local

# 本地模型：tiny / base / small（默认，CER 评测后的本地最优平衡点）/ medium / large-v3
# 准确率评测数据见 docs/asr-benchmark.md
WHISPER_MODEL=small
WHISPER_COMPUTE_TYPE=int8

# ---- LLM 总结（阶段三，任务 E）----
# 二选一配置；LLM_PROVIDER=deepseek|qwen 切换厂商。
# 未配置 Key 时总结接口报 SUMMARIZE_NOT_CONFIGURED（明确中文提示，不静默降级）。
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
# DASHSCOPE_API_KEY=          # 通义千问（LLM_PROVIDER=qwen 时使用）
# LLM_MODEL=deepseek-flash    # 可选，覆盖默认模型（qwen 默认 qwen-plus）

# ---- 云端 ASR（OpenAI 兼容协议，手动选择：前端首页选「云端」或 ASR_ENGINE=cloud 时使用）----
# 默认指向硅基流动，使用云端必须配置 CLOUD_ASR_API_KEY——
# 未配置时选择云端会直接报「云端转写未配置」错误（不会静默降级；云端运行期故障仍按 ASR_ENGINE_FALLBACK 降级本地）
# 硅基流动在售 ASR 模型（2026-10 实测，均可走 /audio/transcriptions）：
#   XingChenAGI/XingChenASR-V3.2-Ultra  默认：强中文 ASR，支持 verbose_json 分段时间戳
#   Qwen/Qwen3-ASR-1.7B                 仅整段 text（引擎自动降级 json，无时间戳）
#   FunAudioLLM/SenseVoiceSmall         仅整段 text（同上）
# 兼容服务（按优先级）：
#   硅基流动  https://api.siliconflow.cn/v1
#   OpenRouter https://openrouter.ai/api/v1
#   OpenAI    https://api.openai.com/v1       （模型 whisper-1）
# 通义听悟 / 火山引擎等非 OpenAI 协议暂不支持，按 BaseASREngine 接口扩展（见 app/services/asr.py）
CLOUD_ASR_BASE_URL=https://api.siliconflow.cn/v1
CLOUD_ASR_API_KEY=
CLOUD_ASR_MODEL=XingChenAGI/XingChenASR-V3.2-Ultra

# ---- 人声分离（Demucs，可选依赖 requirements-separation.txt）----
# 实测对「小模型幻觉型」强 BGM 场景收益有限（见 docs/asr-benchmark.md），默认关闭

# 总开关：true 时无条件对转写音频做 Demucs 人声分离；false 时按下方阈值智能触发
ENABLE_VOCAL_SEPARATION=false

# 智能触发阈值：VAD 统计「非语音时长占比」超过该值（BGM/音乐占比高）时自动开启人声分离
VOCAL_SEP_TRIGGER_RATIO=0.4

# B站登录 Cookie（可选，供启用 AI 字幕快路径 + 缓解机房 IP 风控）
# 作用 1：B站 AI 字幕的播放器接口通常需登录才返回；配置后 yt-dlp 携带该 Cookie，
#         带 AI 字幕的视频可走字幕快路径秒级返回；未配置时自动降级到「下载音频 + ASR」路径。
# 作用 2：云端部署时，机房出口 IP 常报 "HTTP Error 412: Precondition Failed"。
#         正常情况下代码会自动获取设备指纹（buvid3/buvid4）来绕过，**无需配置**；
#         只有指纹仍不够时才需要配这一项（配置后会覆盖指纹）。
# 获取方式：浏览器登录 bilibili.com → F12 → Application/存储 → Cookies →
# 复制整段 Cookie（含 SESSDATA 等字段）粘贴于此。注意 Cookie 有效期与隐私（勿提交到 git）。
BILI_COOKIE=

# B站请求 UA（可选）：留空则沿用 yt-dlp 自带 UA。
# 只有在「设备指纹 + 默认 UA」仍被 412 时才需要填一个真实浏览器 UA。
BILI_USER_AGENT=
