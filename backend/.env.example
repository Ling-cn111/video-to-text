# 后端环境变量示例（FastAPI，位于 backend/）

# CORS 白名单（逗号分隔，覆盖默认值 http://localhost:3000,http://127.0.0.1:3000）
# 生产环境建议把自己的正式域名也加进来
CORS_ORIGINS=http://localhost:3000

# 额外的正则白名单（默认放行所有 *.vercel.app 预览/生产域）
CORS_ORIGIN_REGEX=https://.*\.vercel\.app

# yt-dlp 提取信息超时（秒）
EXTRACT_TIMEOUT_SECONDS=30

# 任务持久化（SQLite）路径；默认 backend/data/tasks.db（目录自动创建，已入 .gitignore）
# TASK_DB_PATH=

# 请求限流：每 IP 每分钟 POST 请求数上限（令牌桶，仅拦 POST）；0 = 禁用
RATE_LIMIT_PER_MINUTE=10

# HuggingFace 端点（模型下载/校验走镜像；后端已默认注入，无需配置。
# 若你在其他终端手动设置过 HF_ENDPOINT，以其为准）
# HF_ENDPOINT=https://hf-mirror.com

# ---- 转写（ASR）----

# 音频临时目录（任务结束自动清理）
# AUDIO_DIR=.audio

# ASR 引擎：local（faster-whisper 本地推理，默认）| cloud（OpenAI 兼容接口）
# 场景推荐：
#   追求速度     → local + WHISPER_MODEL=base
#   平衡（推荐） → local + WHISPER_MODEL=small
#   追求准确     → local + WHISPER_MODEL=medium 或 large-v3（large-v3 建议 GPU）
#   高精度云端   → ASR_ENGINE=cloud（见下方云端配置）
ASR_ENGINE=local

# 本地模型：tiny / base / small（默认，CER 评测后的本地最优平衡点）/ medium / large-v3
# 准确率评测数据见 docs/asr-benchmark.md
WHISPER_MODEL=small
WHISPER_COMPUTE_TYPE=int8

# ---- LLM 总结（阶段三，任务 E）----
# 二选一配置；LLM_PROVIDER=deepseek|qwen 切换厂商。
# 未配置 Key 时总结接口报 SUMMARIZE_NOT_CONFIGURED（明确中文提示，不静默降级）。
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
# DASHSCOPE_API_KEY=          # 通义千问（LLM_PROVIDER=qwen 时使用）
# LLM_MODEL=deepseek-flash    # 可选，覆盖默认模型（qwen 默认 qwen-plus）

# ---- 云端 ASR（OpenAI 兼容协议，手动选择：前端首页选「云端」或 ASR_ENGINE=cloud 时使用）----
# 默认指向硅基流动，使用云端必须配置 CLOUD_ASR_API_KEY——
# 未配置时选择云端会直接报「云端转写未配置」错误（不会静默降级；云端运行期故障仍按 ASR_ENGINE_FALLBACK 降级本地）
# 硅基流动在售 ASR 模型（2026-10 实测，均可走 /audio/transcriptions）：
#   XingChenAGI/XingChenASR-V3.2-Ultra  默认：强中文 ASR，支持 verbose_json 分段时间戳
#   Qwen/Qwen3-ASR-1.7B                 仅整段 text（引擎自动降级 json，无时间戳）
#   FunAudioLLM/SenseVoiceSmall         仅整段 text（同上）
# 兼容服务（按优先级）：
#   硅基流动  https://api.siliconflow.cn/v1
#   OpenRouter https://openrouter.ai/api/v1
#   OpenAI    https://api.openai.com/v1       （模型 whisper-1）
# 通义听悟 / 火山引擎等非 OpenAI 协议暂不支持，按 BaseASREngine 接口扩展（见 app/services/asr.py）
CLOUD_ASR_BASE_URL=https://api.siliconflow.cn/v1
CLOUD_ASR_API_KEY=
CLOUD_ASR_MODEL=XingChenAGI/XingChenASR-V3.2-Ultra

# ---- 人声分离（Demucs，可选依赖 requirements-separation.txt）----
# 实测对「小模型幻觉型」强 BGM 场景收益有限（见 docs/asr-benchmark.md），默认关闭

# 总开关：true 时无条件对转写音频做 Demucs 人声分离；false 时按下方阈值智能触发
ENABLE_VOCAL_SEPARATION=false

# 智能触发阈值：VAD 统计「非语音时长占比」超过该值（BGM/音乐占比高）时自动开启人声分离
VOCAL_SEP_TRIGGER_RATIO=0.4

# B站登录 Cookie（可选，供启用 AI 字幕快路径）
# 作用：B站 AI 字幕的播放器接口通常需登录才返回；配置后 yt-dlp 携带该 Cookie，
# 带 AI 字幕的视频可走字幕快路径秒级返回；未配置时自动降级到「下载音频 + ASR」路径。
# 获取方式：浏览器登录 bilibili.com → F12 → Application/存储 → Cookies →
# 复制整段 Cookie（含 SESSDATA 等字段）粘贴于此。注意 Cookie 有效期与隐私（勿提交到 git）。
BILI_COOKIE=
