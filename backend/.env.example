# 后端环境变量示例（FastAPI，位于 backend/）

# CORS 白名单（逗号分隔，覆盖默认值 http://localhost:3000,http://127.0.0.1:3000）
# 生产环境建议把自己的正式域名也加进来
CORS_ORIGINS=http://localhost:3000

# 额外的正则白名单（默认放行所有 *.vercel.app 预览/生产域）
CORS_ORIGIN_REGEX=https://.*\.vercel\.app

# yt-dlp 提取信息超时（秒）
EXTRACT_TIMEOUT_SECONDS=30

# ---- 转写（ASR）----

# 音频临时目录（任务结束自动清理）
# AUDIO_DIR=.audio

# ASR 提供方：local（faster-whisper 本地推理，默认）| cloud（OpenAI 兼容接口）
ASR_PROVIDER=local

# 本地模型：tiny / base（默认，约 140MB 首次自动下载）/ small（更准更慢）
WHISPER_MODEL=base
WHISPER_COMPUTE_TYPE=int8

# 云端 ASR（OpenAI 兼容协议）；未配置 ASR_API_KEY 时云端模式报友好错误
ASR_API_BASE=https://api.openai.com/v1
ASR_API_KEY=
ASR_CLOUD_MODEL=whisper-1

# B站登录 Cookie（可选，供启用 AI 字幕快路径）
# 作用：B站 AI 字幕的播放器接口通常需登录才返回；配置后 yt-dlp 携带该 Cookie，
# 带 AI 字幕的视频可走字幕快路径秒级返回；未配置时自动降级到「下载音频 + ASR」路径。
# 获取方式：浏览器登录 bilibili.com → F12 → Application/存储 → Cookies →
# 复制整段 Cookie（含 SESSDATA 等字段）粘贴于此。注意 Cookie 有效期与隐私（勿提交到 git）。
BILI_COOKIE=
