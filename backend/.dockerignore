# Docker 构建上下文排除（backend/）
# 注意：构建上下文是 backend/ 目录，故 .env.local（含真实 Key）必须排除，
# 容器配置一律经环境变量注入（见 Dockerfile 顶部说明）。

# Python 虚拟环境 / 缓存 / 编译产物
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# 测试与开发脚本（运行时不需要）
tests/
scripts/

# 本地配置与密钥（务必排除：容器只用注入的环境变量）
.env
.env.local
.env.*.local

# 运行数据（SQLite 任务库等）
data/

# 文档与容器自身文件
*.md
Dockerfile
.dockerignore

# 其它
.git/
.gitignore
.audio*/
